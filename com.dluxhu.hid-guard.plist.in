<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed root:wheel 644 at /Library/LaunchAgents/com.dluxhu.hid-guard.plist.
     A LaunchAgent: runs as the logged-in user in their GUI (Aqua) session, never as root.
     install.sh marks it disabled; `hid-guard enable` enables and loads it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dluxhu.hid-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/hid-guard/hid-guard-helper</string>
    <string>watch</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
